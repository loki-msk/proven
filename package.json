{
  "name": "proven",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Payment follows proof. AI-adjudicated milestone settlement on PayPal.",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "node --import tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "verify": "node --import tsx scripts/verify.mjs",
    "spike": "node scripts/paypal-spike.mjs",
    "ai:smoke": "node scripts/ai-smoke.mjs"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "@paypal/react-paypal-js": "^8.7.0",
    "ag-grid-community": "^32.3.9",
    "ag-grid-react": "^32.3.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^2.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
