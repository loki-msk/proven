# ---------------------------------------------------------------------------
# Proven — environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- PayPal (sandbox) ------------------------------------------------------
# https://developer.paypal.com/dashboard/applications/sandbox
# Create an app under "Sandbox" -> Apps & Credentials -> Default Application.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# --- AI (any OpenAI-compatible chat-completions endpoint) -------------------
# Defaults below point at OpenCode Zen. Any compatible provider works:
#   OpenAI    https://api.openai.com/v1                (gpt-4o / gpt-4.1)
#   Gemini    https://generativelanguage.googleapis.com/v1beta/openai
#   Anthropic https://api.anthropic.com/v1  (via an OpenAI shim only)
AI_BASE_URL=https://opencode.ai/inference/openai/v1
AI_API_KEY=
AI_MODEL=deepseek-v4.1-flash-free
# Vision-capable model used for evidence adjudication. Leave blank to run
# adjudication on text + metadata only (the model then lowers confidence).
AI_VISION_MODEL=nemotron-3.5-super-vl-free
# Set to 0 if your gateway rejects response_format={"type":"json_object"}.
AI_JSON_MODE=1

# --- Server ----------------------------------------------------------------
PORT=8787
# Where the JSON store and uploaded evidence live. Defaults to ./data
# DATA_DIR=
