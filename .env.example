# ---------------------------------------------------------------------------
# Proven — environment
#
#   cp .env.example .env        (Windows: copy .env.example .env)
#
# .env is gitignored. Never commit real values.
# Everything here is optional except the two PayPal credentials, and even those
# are only needed for the money step: `npm run verify` passes without any.
# ---------------------------------------------------------------------------

# --- PayPal (sandbox) ------------------------------------------------------
# https://developer.paypal.com/dashboard/applications/sandbox
#
# IMPORTANT: the sandbox BUSINESS account linked to this app is the payee, and
# it must be a US / USD account. An India-linked payee rejects USD checkouts
# with UNSUPPORTED_PAYEE_CURRENCY. Create the app after creating a US business
# sandbox account, or re-create it against that account.
#
# The buyer is a sandbox PERSONAL account. A business account cannot pay itself.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# --- AI (any OpenAI-compatible chat-completions endpoint) -------------------
# Leave AI_API_KEY blank to run the deterministic, clearly-labelled offline
# fallback. The app never presents fallback output as model output.
AI_BASE_URL=https://opencode.ai/inference/openai/v1
AI_API_KEY=
AI_MODEL=deepseek-v4.1-flash-free
# Vision-capable model used to inspect evidence images. Blank = adjudicate from
# metadata only, with lower confidence.
AI_VISION_MODEL=nemotron-3.5-super-vl-free
# Set to 0 if your gateway rejects response_format={"type":"json_object"}.
AI_JSON_MODE=1

# --- Server ----------------------------------------------------------------
PORT=8787
# JSON store + uploaded evidence. Defaults to ./data, created on first run.
# DATA_DIR=

# --- Agent API -------------------------------------------------------------
# Blank = open agent surface (judges can curl it without a key).
# Set to any long random string to require: Authorization: Bearer <value>
AGENT_API_KEY=
